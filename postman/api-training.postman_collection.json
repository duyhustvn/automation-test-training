          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái phản hồi là 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Thông báo đăng ký thành công\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"Đăng ký thành công\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Đăng ký thất bại - Trùng Username (409)",
