            "description": "Thử đăng ký lại với cùng username đã tồn tại trong database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái phản hồi là 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
