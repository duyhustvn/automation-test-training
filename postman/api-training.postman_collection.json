    {
      "name": "02. Authentication - Login",
      "item": [
        {
          "name": "2.1 Đăng nhập thành công & Lưu Token (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "Đăng nhập với username và password chính xác, tự động lưu token vào biến authToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái phản hồi là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Đăng nhập thành công và có trả về Token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"Đăng nhập thành công\");",
                  "    pm.expect(jsonData.token).to.be.a(\"string\");",
                  "    ",
                  "    // Tự động lưu Token vào biến collection để tái sử dụng",
                  "    pm.collectionVariables.set(\"authToken\", jsonData.token);",
                  "    console.log(\"Saved authToken: \" + jsonData.token);",
                  "});"
                ]
              }
            }
          ]
        },
