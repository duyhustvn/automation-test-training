            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "register"]
            },
            "description": "Tạo mới một tài khoản người dùng vào MongoDB (mật khẩu được hash bcrypt)."
